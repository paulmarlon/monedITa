// ==========================================
// 1. GESTIÓN DE CICLOS Y CONVOCATORIAS
// ==========================================
Table ciclos {
  id int [pk, increment]
  nombre varchar // Ej: "Semestre 1/2026"
  estado varchar // "ACTIVO", "CERRADO"
  fecha_inicio timestamp
  fecha_fin timestamp
  created_at timestamp
  updated_at timestamp
}

// ==========================================
// 2. GESTIÓN DE TEAMS (EQUIPOS / AULAS)
// ==========================================
Table teams {
  id int [pk, increment]
  nombre varchar // Ej: "Los Únicos", "Sembradores de Paz"
  ciclo_id int [ref: > ciclos.id]
  created_at timestamp
  updated_at timestamp
}

// ==========================================
// 3. USUARIOS (Adaptado a Laravel + Spatie)
// ==========================================
Table users {
  id int [pk, increment]
  registro_universitario varchar [unique, not null] // El que usan para loguearse
  name varchar
  email varchar [null, unique]
  email_verified_at timestamp [null]
  password varchar
  team_id int [ref: > teams.id, null] // Null si es admin general
  remember_token varchar [null]
  created_at timestamp
  updated_at timestamp
}

// ==========================================
// 4. BILLETERA VIRTUAL (WALLET DE MONEDITAS)
// ==========================================
Table wallets {
  id int [pk, increment]
  user_id int [ref: - users.id, unique]
  saldo_actual decimal(10,2) [default: 0.00]
  updated_at timestamp
}

// ==========================================
// 5. CAUSA DINOSAURIO (FONDO COMÚN)
// ==========================================
Table causa_comun {
  id int [pk, increment]
  ciclo_id int [ref: > ciclos.id]
  total_acumulado decimal(10,2) [default: 0.00]
  descripcion varchar
  updated_at timestamp
}

// ==========================================
// 6. AUDITORÍA Y TRAZABILIDAD (LIBRO MAYOR)
// ==========================================
Table transacciones {
  id int [pk, increment]
  ciclo_id int [ref: > ciclos.id]
  emisor_id int [ref: > users.id, null] // Null si viene del sistema
  receptor_id int [ref: > users.id, null] // Null si va a la causa dinosaurio
  monto decimal(10,2)
  tipo_operacion varchar // "RECICLAJE", "REPARTO_GRUPAL", "DUELO", "CAUSA_DINOSAURIO", "MINIJUEGO"
  observacion varchar
  created_at timestamp
}

// ==========================================
// 7. MINIJUEGOS INDIVIDUALES (RANKINGS)
// ==========================================
Table minijuegos_puntajes {
  id int [pk, increment]
  user_id int [ref: > users.id]
  juego_nombre varchar
  puntaje int
  created_at timestamp
}
