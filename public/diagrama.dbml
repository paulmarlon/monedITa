// ==========================================
// DBML OFICIAL Y ESTABLE: monedITa (Definitivo)
// ==========================================

// 1. AULAS Y CARRERAS (Para la competencia entre cursos y carreras)
Table aulas {
  id int [pk, increment]
  nombre_carrera varchar // Ej: "Ingeniería de Sistemas"
  periodo_academico varchar // Ej: "5to Semestre"
  sobrenombre varchar // Ej: "Los Magios"
  created_at timestamp
}

// 2. USUARIOS Y BILLETERA
Table usuarios {
  id int [pk, increment]
  aula_id int [ref: > aulas.id]
  nombre varchar
  correo varchar
  rol varchar // 'estudiante', 'admin_reciclaje'
  saldo_creditos int [default: 0] // Billetera centralizada de créditos monedITa
  created_at timestamp
}

// 3. CAMPAÑAS SOLIDARIAS (El impacto real de las tapitas)
Table causas_solidarias {
  id int [pk, increment]
  titulo varchar // Ej: "Campaña de Ayuda Social - Hospital del Niño"
  meta_tapitas int
  tapitas_actuales int [default: 0]
  estado varchar // 'activo', 'completado'
  created_at timestamp
}

// Registro de entregas físicas vs créditos virtuales (Genera los reportes para la dirección)
Table donaciones_tapitas {
  id int [pk, increment]
  usuario_id int [ref: > usuarios.id] // Estudiante que entrega
  causa_solidaria_id int [ref: > causas_solidarias.id]
  cantidad_tapitas int
  creditos_ganados int
  registrado_por int [ref: > usuarios.id] // Admin que validó
  created_at timestamp
}

// 4. GAMIFICACIÓN Y DUELOS MÓVILES (Progreso paralelo, seguro para la banca)
Table duelos_minijuego {
  id int [pk, increment]
  retador_id int [ref: > usuarios.id] // Quien inicia el reto móvil
  retado_id int [ref: > usuarios.id] // Quien acepta el reto en su dispositivo
  puntaje_retador int [default: 0] // Puntaje final obtenido por el retador
  puntaje_retado int [default: 0] // Puntaje final obtenido por el retado
  ganador_id int [ref: > usuarios.id, null] // Definido por el sistema al comparar puntajes
  estado varchar // 'pendiente', 'en_curso', 'completado'
  created_at timestamp
}

// 5. COMUNIDAD (El Patio Digital)
Table publicaciones_sociales {
  id int [pk, increment]
  usuario_id int [ref: > usuarios.id]
  mensaje text // Ej: "¡El curso de 5to semestre acaba de romper récord en el duelo y en donaciones!"
  cantidad_likes int [default: 0]
  created_at timestamp
}