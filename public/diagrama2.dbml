// ==========================================
// 0. CONFIGURACIÓN GENERAL
// ==========================================
Table configuracions {
    id bigint [pk, increment]
    nombre varchar [not null]
    descripcion text [null]
    direccion varchar [null]
    telefono varchar [null]
    correo varchar [null]
    web varchar [null]
    logo varchar [null]
    created_at timestamp [null]
    updated_at timestamp [null]
}

// ==========================================
// 1. GESTIÓN DE CICLOS Y CONVOCATORIAS
// ==========================================
Table ciclos {
    id bigint [pk, increment]
    nombre varchar [not null] // Ej: "Periodo 1/2026"
    estado varchar [default: 'ACTIVO', not null] // "ACTIVO", "CERRADO"
    fecha_inicio timestamp [null]
    fecha_fin timestamp [null]
    created_at timestamp [null]
    updated_at timestamp [null]
    deleted_at timestamp [null] // SoftDeletes
}

// ==========================================
// 2. GESTIÓN DE TEAMS (EQUIPOS / AULAS)
// ==========================================
Table teams {
    id bigint [pk, increment]
    nombre varchar [not null]
    ciclo_id bigint [ref: > ciclos.id, not null] // onDelete: cascade
    logo varchar [null]
    created_at timestamp [null]
    updated_at timestamp [null]
    deleted_at timestamp [null] // SoftDeletes
}

// ==========================================
// 3. USUARIOS (Laravel + Sanctum + Spatie + 2FA)
// ==========================================
Table users {
    id bigint [pk, increment]
    registro_universitario varchar [unique, not null] // Clave para el login
    name varchar [not null]
    alias varchar [unique, not null]
    email varchar [unique, not null] // Destino para envío de código 2FA (o canal configurado)
    email_verified_at timestamp [null]
    password varchar [not null]
    two_factor_secret text [null, note: 'AÑADIDO (tapITa): secreto cifrado para 2FA / TOTP']
    two_factor_recovery_codes text [null, note: 'AÑADIDO (tapITa): códigos de recuperación 2FA']
    two_factor_confirmed_at timestamp [null, note: 'AÑADIDO (tapITa): fecha de confirmación 2FA']
    avatar varchar [null]
    team_id bigint [ref: > teams.id, null] // onDelete: set null
    remember_token varchar [null]
    created_at timestamp [null]
    updated_at timestamp [null]
}

// ==========================================
// 3A. ASIGNACIÓN DE ROLES Y EQUIPOS POR CICLO
// ==========================================
// Registra el rol (ADMINISTRADOR, SUPERVISOR, ESTUDIANTE) y equipo de cada usuario
// en cada período académico para conservar historial al iniciar una nueva partida.
// El administrador inicial por defecto (ej. primer admin) permanece protegido.
Table ciclo_usuario_roles {
    id bigint [pk, increment]
    ciclo_id bigint [ref: > ciclos.id, not null] // onDelete: cascade
    user_id bigint [ref: > users.id, not null] // onDelete: cascade
    role_name varchar [not null, note: 'ADMINISTRADOR, SUPERVISOR, ESTUDIANTE']
    team_id bigint [ref: > teams.id, null] // onDelete: set null
    asignado_por bigint [ref: > users.id, null] // onDelete: set null
    created_at timestamp [null]
    updated_at timestamp [null]

    indexes {
        (ciclo_id, user_id) [unique, name: 'uq_ciclo_usuario_rol']
    }

}

// ==========================================
// 3B. DISPOSITIVOS CONFIABLES POR USUARIO
// ==========================================
Table dispositivos_confiables {
    id bigint [pk, increment]
    user_id bigint [ref: > users.id, not null] // onDelete: cascade
    device_id varchar(120) [not null, note: 'UUID/identificador enviado por Android en login y 2fa/verify']
    device_name varchar(100) [null, note: 'Ej: TECNO KL4h']
    verified_at timestamp [null, note: 'Null mientras el desafío 2FA esté pendiente; timestamp al confirmar el código']
    last_used_at timestamp [null, note: 'Se actualiza al verificar 2FA o al iniciar sesión en un dispositivo ya confiable']
    created_at timestamp [null]
    updated_at timestamp [null]

    indexes {
        (user_id, device_id) [unique, name: 'uq_user_device_confiable']
    }

}

// ==========================================
// 4. AUTENTICACIÓN API (SANCTUM + ANDROID)
// ==========================================
Table personal_access_tokens {
    id bigint [pk, increment]
    tokenable_type varchar [not null]
    tokenable_id bigint [ref: > users.id, not null, note: 'Cuando tokenable_type es App\\Models\\User']
    name text [not null, note: 'Identificador del dispositivo Android para control de sesión única']
    token varchar(64) [unique, not null]
    abilities text [null]
    last_used_at timestamp [null]
    expires_at timestamp [null]
    created_at timestamp [null]
    updated_at timestamp [null]

    indexes {
        (tokenable_type, tokenable_id) [name: 'pat_tokenable_idx']
    }

}

// ==========================================
// 5. AUDITORÍA DE ACCESOS
// ==========================================
Table auditoria_accesos {
    id bigint [pk, increment]
    user_id bigint [ref: > users.id, null] // nullOnDelete
    ip_address varchar(45) [null]
    user_agent text [null]
    evento varchar [default: 'LOGIN', not null, note: 'LOGIN, LOGOUT, EXPULSADO, 2FA_SOLICITADO, 2FA_VERIFICADO']
    created_at timestamp [not null]
}

// ==========================================
// 6. BILLETERA VIRTUAL (WALLET)
// ==========================================
Table wallets {
    id bigint [pk, increment]
    user_id bigint [ref: - users.id, unique, not null] // onDelete: cascade
    saldo_actual decimal(10,2) [default: 0.00, not null]
    created_at timestamp [null]
    updated_at timestamp [null]
}

// ==========================================
// 7. CAUSA COMÚN
// ==========================================
Table causa_comun {
    id bigint [pk, increment]
    ciclo_id bigint [ref: > ciclos.id, not null] // onDelete: cascade
    total_acumulado decimal(10,2) [default: 0.00, not null]
    descripcion varchar [null]
    created_at timestamp [null]
    updated_at timestamp [null]
}

// ==========================================
// 8. LIBRO MAYOR INMUTABLE (TRANSACCIONS)
// ==========================================
Table transaccions {
    id bigint [pk, increment]
    ciclo_id bigint [ref: > ciclos.id, not null] // onDelete: cascade
    emisor_id bigint [ref: > users.id, null] // null si viene del sistema, set null al borrar user
    receptor_id bigint [ref: > users.id, null] // null si va a causa común, set null al borrar user
    monto decimal(10,2) [not null]
    tipo_operacion varchar [not null, note: 'TRANSFERENCIA, RECICLAJE, CAUSA_DINOSAURIO, CONSUMO_MINIJUEGO, etc.']
    observacion varchar [null]
    created_at timestamp [not null, note: 'Inmutable (useCurrent), sin updated_at']
}

// ==========================================
// 9. CATÁLOGO DE MINIJUEGOS
// ==========================================
Table juegos {}
    id bigint [pk, increment]
    slug varchar [unique, not null]
    titulo varchar [not null]
    descripcion text [null]
    costo_ficha decimal(10,2) [default: 0.00, not null]
    activo boolean [default: true, not null]
    created_at timestamp [null]
    updated_at timestamp [null]
    deleted_at timestamp [null] // SoftDeletes
}

// ==========================================
// 10. PUNTAJES DE MINIJUEGOS
// ==========================================
Table minijuegos_puntajes {
    id bigint [pk, increment]
    user_id bigint [ref: > users.id, not null] // onDelete: cascade
    juego_id bigint [ref: > juegos.id, not null] // onDelete: cascade
    puntaje int [not null]
    created_at timestamp [not null]
    updated_at timestamp [null]
}
